SECRET_KEY=unsafe-dev-secret-change-me
DEBUG=True
# Add the host you serve from: EC2 public IP/DNS, or your domain.
ALLOWED_HOSTS=localhost,127.0.0.1,backend,13.214.121.93

# Database (compose overrides POSTGRES_HOST to "db")
POSTGRES_DB=cube_bi
POSTGRES_USER=cube_bi
POSTGRES_PASSWORD=cube_bi_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Data provider: "mock" (reads local DB) or "http" (calls real customer API)
DATA_PROVIDER=mock
HTTP_PROVIDER_BASE_URL=
HTTP_PROVIDER_API_KEY=

# JWT refresh cookie
JWT_COOKIE_SECURE=False
JWT_COOKIE_SAMESITE=Lax

# CORS - frontend origin (only needed when frontend is on a different origin
# than the backend, e.g. dev mode with Vite on :5173 talking to Django on :8000).
# Prod via nginx is same-origin and doesn't need this.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://13.214.121.93:5173
